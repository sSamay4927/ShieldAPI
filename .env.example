# ==============================================================================
# ShieldAPI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit the actual .env file or production secrets to Git.

# Node runtime environment (development, test, production)
NODE_ENV=development

# Port on which the ShieldAPI gateway listens
PORT=3000

# Base URL of the downstream target API that allowed traffic is forwarded to
UPSTREAM_BASE_URL=http://localhost:4001

# Redis connection URL (used for atomic Lua rate-limiter and BullMQ)
REDIS_URL=redis://localhost:6379

# MongoDB connection string (used for durable audit log persistence)
MONGODB_URI=mongodb://localhost:27017/shieldapi

# Rate Limit Window duration in milliseconds (default: 60,000 ms = 60 seconds)
RATE_LIMIT_WINDOW_MS=60000

# Maximum accepted requests allowed per client identity in the window
RATE_LIMIT_MAX_REQUESTS=5

# Rate limit failure mode when Redis is unreachable (closed = HTTP 503, open = pass)
RATE_LIMIT_FAIL_MODE=closed

# Client identity resolution strategy (api-key-or-ip)
RATE_LIMIT_IDENTITY_MODE=api-key-or-ip

# HMAC-SHA256 secret key used to hash API keys and client IPs before storing in Redis/Mongo
# Change to a long random secret in production!
IDENTITY_HASH_SECRET=development-local-hmac-secret-change-in-production

# Proxy timeout in milliseconds before returning 504 Gateway Timeout
PROXY_TIMEOUT_MS=5000

# Audit log document retention period in days (for TTL index)
AUDIT_RETENTION_DAYS=30

